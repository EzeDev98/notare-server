#####################################################
# Datasource (MySQL ? local)
#####################################################
spring.datasource.url=jdbc:mysql://localhost:3306/notare_db?serverTimezone=Africa/Lagos
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

#####################################################
# JPA / Hibernate
#####################################################
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

#####################################################
# Flyway ? OFF in dev on purpose. Dev keeps using ddl-auto=update against
# MySQL exactly as before; db/migration/*.sql (added for prod/Postgres in
# step 2) targets Postgres syntax (BYTEA, GENERATED BY DEFAULT AS IDENTITY)
# and was never meant to run here. Same reasoning application-test.properties
# already applies for H2.
#####################################################
spring.flyway.enabled=false

#####################################################
# File storage (local ? dev)
# Relative to the process working directory. Create the folder or let
# the storage service create it on first write. Override with the env var
# if you want uploads to land elsewhere.
#####################################################
notare.storage.local.location=${VOICE_STORAGE_LOCATION:./uploads/voice-notes}

#####################################################
# Logging
#####################################################
logging.level.com.notare=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.springframework.security=DEBUG

####################
# Server
####################
server.port=2001
base-url=http://localhost:2001

#####################################################
# JWT (dev-only convenience default ? never reused in prod)
#####################################################
app.jwt.secret=${JWT_SECRET:CHANGE_ME}

#####################################################
# Admin wipe secret (dev-only convenience default — never reused in prod)
#####################################################
app.admin.wipe-secret=${ADMIN_WIPE_SECRET:CHANGE_ME}

#####################################################
# Redis (sessions/refresh tokens)
#####################################################
spring.data.redis.host=localhost
spring.data.redis.port=6379
#####################################################
# internal-auth-server (IAM)
# base-url must include the API prefix: InternalAuthClient appends /auth/register etc.
# client-secret has no default on purpose (fails fast at boot, like app.jwt.secret).
# Create the "notare" client in IAM, then: export INTERNAL_AUTH_CLIENT_SECRET=...
#####################################################
internal-auth.base-url=${INTERNAL_AUTH_BASE_URL:http://localhost:5151/api/v1}
internal-auth.client-id=${INTERNAL_AUTH_CLIENT_ID:}
internal-auth.client-secret=${INTERNAL_AUTH_CLIENT_SECRET:}
# Must equal IAM's ADMIN_RESET_SECRET: lets notare's wipe also wipe its tenant in IAM.
internal-auth.reset.secret=${INTERNAL_AUTH_RESET_SECRET:}
# IAM issuer (its root URL, NOT the /api/v1 base). JWKS is read from <issuer>/oauth2/jwks.
internal-auth.issuer-uri=${INTERNAL_AUTH_ISSUER_URI:http://localhost:5151}
# Optional but recommended: IAM's numeric client_application_id for notare; tokens minted for other tenants are then rejected.
internal-auth.client-application-id=${INTERNAL_AUTH_CLIENT_APPLICATION_ID:}
