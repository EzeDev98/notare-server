# Template for application-dev.properties.

spring.datasource.url=jdbc:mysql://localhost:3306/notare_db?serverTimezone=Africa/Lagos
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

spring.flyway.enabled=false

notare.storage.local.location=${VOICE_STORAGE_LOCATION:./uploads/voice-notes}

logging.level.com.notare=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.springframework.security=DEBUG

server.port=2001
base-url=http://localhost:2001

app.jwt.secret=${JWT_SECRET:CHANGE_ME}

app.admin.wipe-secret=${ADMIN_WIPE_SECRET:CHANGE_ME}

spring.data.redis.host=localhost
spring.data.redis.port=6379
internal-auth.base-url=${INTERNAL_AUTH_BASE_URL:http://localhost:5151/api/v1}
internal-auth.client-id=${INTERNAL_AUTH_CLIENT_ID:}
internal-auth.client-secret=${INTERNAL_AUTH_CLIENT_SECRET:}
internal-auth.reset.secret=${INTERNAL_AUTH_RESET_SECRET:}
internal-auth.issuer-uri=${INTERNAL_AUTH_ISSUER_URI:http://localhost:5151}
internal-auth.client-application-id=${INTERNAL_AUTH_CLIENT_APPLICATION_ID:}
